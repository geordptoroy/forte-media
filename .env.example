# --- CONFIGURAÇÕES GERAIS ---
NODE_ENV=production
PORT=4000
SESSION_SECRET=supersecret_mude_isso_em_producao
ENCRYPTION_KEY=default-key-change-in-production-32chars

# --- BANCO DE DADOS (DOCKER) ---
DB_USER=forte_user
DB_PASSWORD=forte_password
DB_NAME=forte_media
DB_ROOT_PASSWORD=root-password

# --- META API (CONFIGURAÇÃO GLOBAL) ---
# Obtenha o User Access Token em https://developers.facebook.com/tools/explorer/
# Necessário permissão: ads_read
META_ACCESS_TOKEN=seu_access_token_aqui

# --- ANALYTICS (OPCIONAL) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- NGROK CONFIGURATION ---
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# --- CONFIGURAÇÕES DE URL ---
FRONTEND_URL=https://localhost
BACKEND_URL=https://localhost/api
VITE_API_URL=http://localhost:4000
